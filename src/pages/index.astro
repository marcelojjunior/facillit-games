---
import BaseLayout from '../layouts/BaseLayout.astro';
import LoadingFrame from '../components/LoadingFrame.astro';
import MatchIsland from '../components/MatchIsland';
---

<BaseLayout title="Facillit Games">
  <!--
    client:only="react", NEVER another directive (Principle IV): the island
    reads localStorage, which does not exist at build time. Any directive that
    renders on the server causes a hydration mismatch and an empty-screen flash
    on every open -- the normal use of the app (phone on the table, tab
    discarded). tests/static-build.test.ts and tests/island-directives.test.ts
    fail if this changes.
  -->
  <MatchIsland client:only="react">
    <LoadingFrame slot="fallback" />
  </MatchIsland>
</BaseLayout>
