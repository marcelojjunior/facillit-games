---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClientOnlyProbe from '../components/ClientOnlyProbe';
---

<BaseLayout title="Facillit Games — fundacao">
  <main class="mx-auto max-w-prose px-4 py-10">
    <h1 class="text-2xl font-semibold">Facillit Games</h1>

    <p class="mt-4 text-sm leading-relaxed">
      Fundacao tecnica da plataforma. Esta pagina existe para provar que o pipeline de build
      estatico funciona e e descartada na Fase 4, junto com o design system e as telas reais.
    </p>

    <p class="mt-4 text-sm leading-relaxed">
      Nao ha jogo, cadastro de jogadores nem marcador de pontuacao aqui — por escopo, nao por falta.
    </p>

    <!--
      client:only, NOT client:load.

      With client:load the component renders at build time, where the browser
      API it reads does not exist: that causes a hydration mismatch and an
      empty-screen flash on every open -- which is the normal use of the app
      (phone on the table, tab discarded by the browser). Constitution
      Principle IV.

      tests/static-build.test.ts asserts that this island's markup does NOT
      appear in dist/index.html. Changing the directive here makes that test
      fail, which is the point: without it, the change would go unnoticed.
    -->
    <ClientOnlyProbe client:only="react" />
  </main>
</BaseLayout>
