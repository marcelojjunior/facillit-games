---
/**
 * The background scene (spec 004 research D4): a daytime sky with clouds and
 * hills, or a night sky with stars. Static markup in the layout, so the boot
 * script's data-theme already picks the right scene for the first frame
 * (FR-017); it holds no match state, so rendering it at build time is fine
 * (Principle IV). Scene tokens only: `cloud` is transparent at night and
 * `star` by day.
 */
const stars = [
  [24, 40, 1.6],
  [70, 18, 1.2],
  [118, 62, 1.8],
  [164, 26, 1.3],
  [212, 80, 1.6],
  [258, 34, 1.2],
  [300, 70, 1.8],
  [338, 22, 1.3],
  [46, 120, 1.2],
  [142, 150, 1.5],
  [236, 136, 1.2],
  [320, 168, 1.5],
] as const;
---

<div
  data-testid="scene"
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 -z-10 overflow-hidden bg-linear-to-b from-sky-top to-sky-bottom"
>
  <svg
    class="absolute inset-x-0 top-0 h-64 w-full fill-star"
    viewBox="0 0 360 240"
    preserveAspectRatio="xMidYMin slice"
  >
    {stars.map(([x, y, r]) => (
      <circle cx={x} cy={y} r={r} />
    ))}
  </svg>
  <svg
    class="absolute inset-x-0 bottom-0 h-48 w-full"
    viewBox="0 0 360 190"
    preserveAspectRatio="none"
  >
    <g class="fill-cloud">
      <ellipse cx="70" cy="44" rx="38" ry="13"></ellipse>
      <ellipse cx="96" cy="36" rx="26" ry="13"></ellipse>
      <ellipse cx="292" cy="28" rx="30" ry="10"></ellipse>
    </g>
    <path class="fill-hill-back" d="M0 120 Q90 70 190 110 T360 96 V190 H0 Z"></path>
    <g class="fill-hill-back">
      <circle cx="300" cy="104" r="16"></circle>
      <circle cx="318" cy="96" r="20"></circle>
      <circle cx="338" cy="106" r="15"></circle>
    </g>
    <path class="fill-hill-front" d="M0 150 Q120 105 230 140 T360 130 V190 H0 Z"></path>
  </svg>
</div>
