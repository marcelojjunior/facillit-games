---
/**
 * The mascot's drawing as a static SVG sprite (spec 004 research D11, done
 * before spec 005 adds the first game): drawn once in the page, outside the
 * island, and referenced by `Mascot.tsx` with `<use>`, so the island's script
 * carries none of it. Token fills only.
 */
---

<svg aria-hidden="true" width="0" height="0" class="absolute">
  <defs>
    <symbol id="mascot-crown" viewBox="0 0 80 50">
      <path
        d="M6 44 L10 10 L28 28 L40 4 L52 28 L70 10 L74 44 Z"
        class="fill-gold stroke-yellow-edge"
        stroke-width="4"
        stroke-linejoin="round"
      />
      <circle cx="40" cy="30" r="5" class="fill-red" />
      <circle cx="22" cy="36" r="3.5" class="fill-blue" />
      <circle cx="58" cy="36" r="3.5" class="fill-green" />
    </symbol>
    <symbol id="mascot-die" viewBox="0 0 140 150">
      <ellipse cx="70" cy="143" rx="42" ry="6" class="fill-face opacity-15" />
      <rect x="44" y="122" width="18" height="16" rx="8" class="fill-blue-edge" />
      <rect x="78" y="122" width="18" height="16" rx="8" class="fill-blue-edge" />
      <path
        d="M24 72 q-16 -10 -12 -32"
        class="fill-none stroke-die-edge"
        stroke-width="11"
        stroke-linecap="round"
      />
      <circle cx="12" cy="38" r="8" class="fill-die stroke-die-edge" stroke-width="3" />
      <path
        d="M116 78 q14 6 13 22"
        class="fill-none stroke-die-edge"
        stroke-width="11"
        stroke-linecap="round"
      />
      <rect x="20" y="24" width="100" height="104" rx="28" class="fill-die-edge" />
      <rect x="20" y="16" width="100" height="104" rx="28" class="fill-die" />
      <g class="fill-pip">
        <circle cx="40" cy="36" r="7" />
        <circle cx="100" cy="36" r="7" />
        <circle cx="40" cy="102" r="7" />
        <circle cx="100" cy="102" r="7" />
      </g>
      <ellipse cx="56" cy="64" rx="7" ry="9" class="fill-face" />
      <ellipse cx="84" cy="64" rx="7" ry="9" class="fill-face" />
      <circle cx="58.5" cy="60" r="2.6" class="fill-die" />
      <circle cx="86.5" cy="60" r="2.6" class="fill-die" />
      <ellipse cx="44" cy="79" rx="7" ry="4.5" class="fill-red-hi opacity-75" />
      <ellipse cx="96" cy="79" rx="7" ry="4.5" class="fill-red-hi opacity-75" />
      <path
        d="M58 80 Q70 92 82 80"
        class="fill-red stroke-face"
        stroke-width="4.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </symbol>
  </defs>
</svg>
