---
import '../styles/global.css';
import { bootScript } from '../shell/theme/boot';
import Scene from '../components/Scene.astro';
import MascotSprite from '../components/MascotSprite.astro';
// The hashed URL of the self-hosted font, so the preload hits the same file
// global.css loads (spec 004 research D1).
import fontUrl from '../assets/fonts/baloo-2-latin-wght-normal.woff2?url';
import Analytics from '@vercel/analytics/astro';
import { share } from '../shell/ui/copy';
import { themed } from '../styles/tokens';

interface Props {
  title: string;
}

const { title } = Astro.props;

// Absolute when the build knows the public address (astro.config.mjs `site`).
const absolute = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const image = absolute('/og.png');
const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <!--
      Sets data-theme before first paint (FR-020, research D7 of spec 003):
      reads only the theme key, never match state. Generated from
      src/shell/theme/preference.ts, so it cannot drift from the module.
    -->
    <script is:inline set:html={bootScript()} />
    <!--
      Principle VI: mobile-first. The reference screen is a phone held in one
      hand.
    -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={share.description} />

    <!-- Icons: the mascot die (public/, rendered by scripts/render-share-images.mjs). -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta
      name="theme-color"
      content={themed['sky-top'].light}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content={themed['sky-top'].dark}
      media="(prefers-color-scheme: dark)"
    />

    <!-- Link previews (WhatsApp, Telegram, X, ...). -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Facillit Games" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={share.description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={share.imageAlt} />
    {pageUrl && <meta property="og:url" content={pageUrl} />}
    {pageUrl && <link rel="canonical" href={pageUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={share.description} />
    <meta name="twitter:image" content={image} />
  </head>
  <body>
    <Scene />
    <MascotSprite />
    <slot />
    <!--
      Vercel Web Analytics: page views only, no cookies, sent to this site's own
      origin (/_vercel/insights). Optional: off the Vercel platform the script
      is simply missing and the app works the same (Principle I).
    -->
    <Analytics />
  </body>
</html>
