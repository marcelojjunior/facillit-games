---
import '../styles/global.css';
import { bootScript } from '../shell/theme/boot';
import Scene from '../components/Scene.astro';
import MascotSprite from '../components/MascotSprite.astro';
// The hashed URL of the self-hosted font, so the preload hits the same file
// global.css loads (spec 004 research D1).
import fontUrl from '../assets/fonts/baloo-2-latin-wght-normal.woff2?url';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <!--
      Sets data-theme before first paint (FR-020, research D7 of spec 003):
      reads only the theme key, never match state. Generated from
      src/shell/theme/preference.ts, so it cannot drift from the module.
    -->
    <script is:inline set:html={bootScript()} />
    <!--
      Principle VI: mobile-first. The reference screen is a phone held in one
      hand.
    -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <Scene />
    <MascotSprite />
    <slot />
  </body>
</html>
