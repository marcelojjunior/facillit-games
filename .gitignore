# === Node / pnpm ===
node_modules/
.pnpm-store/
*.tsbuildinfo

# === Astro ===
.astro/
dist/

# === Vercel ===
.vercel/

# === Environment ===
.env
.env.*
!.env.example

# === Logs / OS ===
*.log
npm-debug.log*
pnpm-debug.log*
.DS_Store
Thumbs.db

# === Coverage ===
coverage/

# === Agents ===
# Machine-local permissions and configuration. May contain absolute paths and
# credentials. The rest of .claude/ (the Spec Kit skills) IS versioned on
# purpose: it is what makes the process exist in every clone without reinstalling.
.claude/settings.local.json

# === Spec Kit ===
# .specify/ has its own .gitignore (maintained by the CLI) covering
# feature.json, local overrides, and integration packages. Do not duplicate it
# here. What is missing is the extension catalog cache, which is a download,
# not state:
.specify/extensions/.cache/
