{
  "$schema": "https://json.schemastore.org/tsconfig",

  // `strictest` is a superset of `strict: true` (Principle V). It adds
  // noUncheckedIndexedAccess and exactOptionalPropertyTypes, which are exactly
  // the locks Phase 3 will want when reading a possibly corrupted localStorage
  // payload (Principle VII) and when modeling GameDefinition without `any`.
  // Tightening later would cost more: there would already be code written
  // against the looser rule.
  "extends": "astro/tsconfigs/strictest",

  "compilerOptions": {
    // Required for `astro check` to understand the React island .tsx files.
    // The Astro preset uses `jsx: "preserve"`, which works for .astro but does
    // not resolve the JSX of React components.
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },

  // WARNING: this `exclude` is not hygiene, it is a blocker.
  //
  // The astro/tsconfigs/base preset brings `allowJs: true` with
  // `include: ["${configDir}/**/*"]`. Without the three POC lines below, the
  // 16 KB of script.js enter the TypeScript program and `pnpm typecheck`
  // starts failing on errors in a file the constitution forbids fixing (the
  // POC stays frozen and published until the Phase 6 cutover). The command
  // would only pass by violating the freeze.
  //
  // Overriding `exclude` also drops the preset's `["${configDir}/dist"]`, so
  // `dist` has to be repeated here.
  //
  // See specs/001-astro-foundation/research.md, Decision 3.
  "exclude": ["dist", "node_modules", ".astro", "index.html", "script.js", "style.css"]
}
