{
  "$schema": "https://json.schemastore.org/tsconfig",

  // `strictest` e superset de `strict: true` (Principio V). Adiciona
  // noUncheckedIndexedAccess e exactOptionalPropertyTypes, que sao exatamente
  // as travas que a Fase 3 vai querer ao ler payload de localStorage
  // possivelmente corrompido (Principio VII) e ao modelar GameDefinition sem
  // `any`. Apertar depois custaria mais: ja haveria codigo escrito contra a
  // regra frouxa.
  "extends": "astro/tsconfigs/strictest",

  "compilerOptions": {
    // Necessario para que `astro check` entenda os .tsx das ilhas React. O
    // preset do Astro usa `jsx: "preserve"`, que serve para .astro mas nao
    // resolve o JSX de componentes React.
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },

  // ATENCAO: este `exclude` nao e higiene, e bloqueio.
  //
  // O preset astro/tsconfigs/base traz `allowJs: true` com
  // `include: ["${configDir}/**/*"]`. Sem as tres linhas da POC abaixo, os
  // 16 KB de script.js entram no programa do TypeScript e `pnpm typecheck`
  // passa a reprovar por erros num arquivo que a constituicao proibe corrigir
  // (a POC fica congelada e publicada ate o cutover da Fase 6). O comando so
  // passaria violando o congelamento.
  //
  // Sobrescrever `exclude` tambem descarta o `["${configDir}/dist"]` do preset,
  // entao `dist` precisa ser repetido aqui.
  //
  // Ver specs/001-astro-foundation/research.md, Decisao 3.
  "exclude": ["dist", "node_modules", ".astro", "index.html", "script.js", "style.css"]
}
